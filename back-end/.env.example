PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Autenticacao
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Banco de dados (PostgreSQL)
DATABASE_URL="postgres://usuario:senha@host:5432/primeiro-emprego?sslmode=disable"

# Recursos de IA (opcional: sem a chave, as rotas de IA retornam 503)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Armazenamento de anexos S3/SeaweedFS (opcional: sem as chaves, as rotas de anexo retornam 503)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
